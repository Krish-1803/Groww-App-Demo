# Groww for Gen Z: environment example
#
# The prototype works fully offline with a built-in, intent-matched Groww Buddy
# coach. That is the DEFAULT so the deployed/shared link always works.
#
# The optional "live AI" path (calls the Anthropic API) is for LOCAL DEV ONLY.
# A published static page cannot reach api.anthropic.com, and you must never
# ship an API key in client code. Leave this off for any deployed build.

# Set to "true" to enable the live-AI Buddy path in local dev.
VITE_USE_LIVE_AI=false

# Optional: your Anthropic API key, LOCAL DEV ONLY. Do NOT commit a real value.
# Anything prefixed VITE_ is exposed to the browser bundle, so only ever put a
# throwaway/dev key here and never deploy a build that embeds it.
# VITE_ANTHROPIC_API_KEY=
